оуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйоуйо